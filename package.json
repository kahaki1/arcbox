{
  "name": "arcbox-mcp-server",
  "version": "1.0.0",
  "description": "ChatGPT MCP that assigns each user a Circle developer wallet on Arc Testnet and sends USDC via App Kit.",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "dev:web": "vite --config web/vite.config.js",
    "start": "tsx src/index.ts",
    "build": "npm run build:web && tsc --noEmit",
    "build:web": "vite build --config web/vite.config.js",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": "22.x"
  },
  "dependencies": {
    "@circle-fin/adapter-circle-wallets": "^1.0.0",
    "@circle-fin/app-kit": "^1.0.0",
    "@circle-fin/developer-controlled-wallets": "^10.8.0",
    "@modelcontextprotocol/sdk": "^1.22.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^5.1.0",
    "firebase-admin": "^13.4.0",
    "jose": "^6.0.11",
    "lucide-react": "^0.511.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.9",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.4.21",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.17",
    "vite": "^7.1.2",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/node": "^22.17.0",
    "tsx": "^4.20.3",
    "typescript": "^5.9.2"
  }
}
