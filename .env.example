# Public HTTPS origin ChatGPT will call. Required for OAuth discovery.
# Local ChatGPT testing: use a Cloudflare Tunnel or ngrok URL, then set this to that https origin.
# Example: https://your-subdomain.trycloudflare.com
PUBLIC_URL=http://localhost:8787
PORT=8787

# Allow http:// issuer URLs for local-only testing. ChatGPT itself still needs HTTPS.
MCP_DANGEROUSLY_ALLOW_INSECURE_ISSUER_URL=true

# Random 32+ character secret used to sign session cookies and ID tokens.
COOKIE_SECRET=change-me-to-a-long-random-string

# Circle developer-controlled wallets (testnet key + registered entity secret)
# https://console.circle.com
CIRCLE_API_KEY=
CIRCLE_ENTITY_SECRET=

# Optional. If empty, ArcBox creates a wallet set on first user signup and stores the id in data/.
CIRCLE_WALLET_SET_ID=

# Optional safety cap per user per UTC day (testnet USDC).
SEND_DAILY_LIMIT_USDC=100
