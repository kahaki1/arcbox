# Public HTTPS origin ChatGPT will call. Required for OAuth discovery.
# Local ChatGPT testing: use a Cloudflare Tunnel or ngrok URL, then set this to that https origin.
# Example: https://your-subdomain.trycloudflare.com
PUBLIC_URL=http://localhost:8787
PORT=8787

# Allow http:// issuer URLs for local-only testing. ChatGPT itself still needs HTTPS.
MCP_DANGEROUSLY_ALLOW_INSECURE_ISSUER_URL=true

# Random 32+ character secret used to sign session cookies and ID tokens.
COOKIE_SECRET=change-me-to-a-long-random-string

# Circle developer-controlled wallets (testnet key + registered entity secret)
# https://console.circle.com
CIRCLE_API_KEY=
CIRCLE_ENTITY_SECRET=

# Optional. If empty, Onix creates a wallet set on first user signup and stores the id in data/.
CIRCLE_WALLET_SET_ID=

# Optional safety cap per user per UTC day (testnet USDC).
SEND_DAILY_LIMIT_USDC=100

# Firebase Admin (service account JSON fields)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Firebase Web (public) — used for Google sign-in in the browser
FIREBASE_WEB_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_APP_ID=

# Email login codes. Resend is used if set. Otherwise codes are written to the
# Firestore `mail` collection for the Trigger Email extension.
RESEND_API_KEY=
EMAIL_FROM=Onix <noreply@onixmpc.vercel.app>

# Local only: print the OTP to the server log and skip email.
# OTP_DEBUG=true
